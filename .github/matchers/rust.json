{
  "problemMatcher": [
    {
      "owner": "rustfmt",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(?:Diff in )?(.*?)(?::| at line )(\\d+):$",
          "file": 1,
          "line": 2,
          "message": 0
        }
      ]
    },
    {
      "owner": "clippy",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[\\d;]+m)*(warning|warn|error)(?:\\x1b\\[[\\d;]+m)*(\\[(.*)\\])?(?:\\x1b\\[[\\d;]+m)*:(?:\\x1b\\[[\\d;]+m)* ([^\\x1b]*)(?:\\x1b\\[[\\d;]+m)*$",
          "severity": 1,
          "code": 3,
          "message": 4
        },
        {
          "regexp": "^(?:\\x1b\\[[\\d;]+m)*\\s*(?:\\x1b\\[[\\d;]+m)*\\s*--> (?:\\x1b\\[[\\d;]+m)*(.*):(\\d*):(\\d*)(?:\\x1b\\[[\\d;]+m)*$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    },
    {
      "owner": "cargo-deny",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[\\d;]+m)*(error|warning)(?:\\x1b\\[[\\d;]+m)*\\[(.*?)\\]:(?:\\x1b\\[[\\d;]+m)* (.*?)(?:\\x1b\\[[\\d;]+m)*$",
          "severity": 1,
          "code": 2,
          "message": 3
        },
        {
          "regexp": "^(?:\\x1b\\[[\\d;]+m)*\\s*┌─ (.*?):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    }
  ]
}
