<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body width="600px" background-color="#fefaf3">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="heading">Your sign-in code</mj-text>
        <mj-text>Enter this code in Tunnel Weaver to finish signing in.</mj-text>
        <!-- A single real text string: selectable, no image or split digit boxes. -->
        <mj-text font-family="ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', 'Courier New', monospace" font-size="32px" line-height="40px" font-weight="bold" letter-spacing="4px" padding="8px 32px 24px">{{code}}</mj-text>
        <mj-text mj-class="quiet">This code expires in {{expires_in}}. Don’t share it with anyone.</mj-text>
        <mj-text mj-class="quiet">If you didn’t try to sign in, don’t use or share this code. You can <a href="{{recovery_url}}" style="color:#772a0a;text-decoration:underline;">reset your password</a> if you’re concerned.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
