<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body width="600px" background-color="#fefaf3">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="heading">Reset your password</mj-text>
        <mj-text>We received a request to reset your Tunnel Weaver password. Use the button below to choose a new one.</mj-text>
        <mj-button href="{{reset_url}}">Reset password</mj-button>
        <mj-text mj-class="quiet">This link expires in {{expires_in}}. If you didn’t request this, ignore this email. Your password won’t change.</mj-text>
        <mj-text mj-class="quiet">Button not working? <a href="{{reset_url}}" style="color:#772a0a;text-decoration:underline;word-break:break-all;">{{reset_url}}</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
